      }
    },
    {
      "id": "scene_15",
      "text": "Can Argentina survive the final twenty minutes of the game?",
      "in_seconds": 52.14,
      "source": "projects/fifa_prediction_project_9/images/[00-52]_Hand-drawn_2D_doo.jpg",
      "out_seconds": 55.14,
