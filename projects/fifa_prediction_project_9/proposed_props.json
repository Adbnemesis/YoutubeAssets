        "volume": 0.8,
        "startOffsetSeconds": 0.0
      }
    },
    {
      "id": "scene_19",
      "text": "The stadium will erupt into pure chaos.",
      "in_seconds": 63.12,
      "source": "projects/fifa_prediction_project_9/images/[01-03]_Hand-drawn_2D_doo.jpg",
