        "startOffsetSeconds": 0.0
      }
    },
    {
      "id": "scene_12",
      "text": "He will capitalize on a rare defensive mistake right before the whistle.",
      "in_seconds": 40.5,
      "source": "projects/fifa_prediction_project_9/images/[00-40]_Hand-drawn_2D_doo.jpg",
