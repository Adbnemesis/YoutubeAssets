        "startOffsetSeconds": 0.0
      }
    },
    {
      "id": "scene_18",
      "text": "In the eighty-ninth minute, Lionel Messi will score a stunning free kick to make it two to two.",
      "in_seconds": 58.38,
      "source": "projects/fifa_prediction_project_9/images/[00-58]_Hand-drawn_2D_doo.jpg",
