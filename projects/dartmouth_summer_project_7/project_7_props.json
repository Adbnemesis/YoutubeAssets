{
  "theme": "flat-motion-graphics",
  "themeConfig": {
    "backgroundColor": "#0F172A",
    "primaryColor": "#7C3AED",
    "accentColor": "#EC4899",
    "surfaceColor": "#1E293B",
    "textColor": "#F8FAFC",
    "captionHighlightColor": "#22D3EE",
    "captionBackgroundColor": "rgba(15, 23, 42, 0.75)",
    "chartColors": [
      "#7C3AED",
      "#EC4899",
      "#06B6D4",
