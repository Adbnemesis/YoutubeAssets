{
  "theme": "flat-motion-graphics",
  "themeConfig": {
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#2D5FBF",
    "accentColor": "#F5820D",
    "surfaceColor": "#FFFFFF",
    "textColor": "#000000",
    "captionHighlightColor": "#F5820D",
    "captionBackgroundColor": "rgba(255, 255, 255, 0.85)",
    "chartColors": [
      "#F5820D",
      "#2D5FBF",
      "#3A9E3A",
