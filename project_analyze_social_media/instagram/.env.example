# Instagram Graph API Read-Only Credentials
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Your Facebook / Instagram User Long-Lived Access Token
# Generated with read-only scopes: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here

# Your Instagram Business / Creator Account ID (numeric string, e.g. 17841400000000000)
# (Leave empty if you want the script to auto-discover it from your connected pages)
INSTAGRAM_ACCOUNT_ID=
