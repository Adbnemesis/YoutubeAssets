  "blocks": [
    {
      "id": "git01_hook",
      "speaker": "narrator",
      "text": "Your project has 1,000 files, but .git is barely 10 megabytes. How?",
      "start_ms": 0,
      "end_ms": 4330,
      "duration_ms": 4330,
      "start_frame": 0,
      "end_frame": 130,
      "cues": [
        {
          "phrase": "1,000 files",
          "cue": "vortex_files_spawn",
          "frame": 45
        },
        {
          "phrase": "10 megabytes",
          "cue": "compression_lock",
          "frame": 104
        }
      ],
      "wav_path": "/Users/talus/Downloads/youtube_ai/OpenMontage/project_tech/reels/git_18/audio/blocks/git01_hook.wav"
    },
    {
      "id": "git02_nemi",
      "speaker": "nemi",
      "text": "Doesn't it just save text diffs? \ud83e\udd14",
      "start_ms": 4370,
      "end_ms": 6034,
      "duration_ms": 1664,
      "start_frame": 131,
      "end_frame": 181,
      "cues": [
        {
          "phrase": "text diffs",
          "cue": "diff_slash_out",
          "frame": 156
        }
      ],
      "wav_path": "/Users/talus/Downloads/youtube_ai/OpenMontage/project_tech/reels/git_18/audio/blocks/git02_nemi.wav"
    },
    {
      "id": "git03_prism",
      "speaker": "narrator",
      "text": "No! Every file is hashed into a unique SHA-1 blob.",
      "start_ms": 6074,
      "end_ms": 9359,
      "duration_ms": 3285,
      "start_frame": 182,
      "end_frame": 281,
      "cues": [
        {
          "phrase": "hashed into",
          "cue": "prism_hash_beam",
          "frame": 222
        },
        {
          "phrase": "SHA-1 blob",
          "cue": "blob_crystal_reveal",
          "frame": 261
        }
      ],
      "wav_path": "/Users/talus/Downloads/youtube_ai/OpenMontage/project_tech/reels/git_18/audio/blocks/git03_prism.wav"
    },
    {
      "id": "git04_mutation",
      "speaker": "narrator",
      "text": "When you edit one file, Git only creates one new blob and reuses the other 999 pointers for free!",
      "start_ms": 9399,
      "end_ms": 14220,
      "duration_ms": 4821,
      "start_frame": 282,
      "end_frame": 427,
      "cues": [
        {
          "phrase": "one new blob",
          "cue": "single_mutation_spark",
          "frame": 340
        },
        {
          "phrase": "999 pointers",
          "cue": "pointer_web_lock",
          "frame": 398
        }
      ],
      "wav_path": "/Users/talus/Downloads/youtube_ai/OpenMontage/project_tech/reels/git_18/audio/blocks/git04_mutation.wav"
    },
    {
      "id": "git05_nemi",
      "speaker": "nemi",
      "text": "Zero duplicate copies, just a tree of hashes! \ud83d\ude0e\u26a1",
      "start_ms": 14260,
      "end_ms": 16969,
      "duration_ms": 2709,
      "start_frame": 428,
      "end_frame": 509,
      "cues": [
        {
          "phrase": "tree of hashes",
          "cue": "dag_tree_bloom",
          "frame": 477
        }
      ],
      "wav_path": "/Users/talus/Downloads/youtube_ai/OpenMontage/project_tech/reels/git_18/audio/blocks/git05_nemi.wav"
    },
    {
      "id": "git06_loop",
      "speaker": "narrator",
      "text": "That's how Git snapshots your entire codebase in milliseconds.",
      "start_ms": 17009,
      "end_ms": 19633,
      "duration_ms": 2624,
      "start_frame": 510,
      "end_frame": 589,
      "cues": [
